# Copy to .streamlit/secrets.toml locally, or paste into Streamlit Cloud > App settings > Secrets.
UW_API_TOKEN = "your-unusual-whales-api-token"
APP_PASSWORD = "the-password-subscribers-or-staff-type-in"
# SEC asks automated clients to identify themselves with a real contact.
SEC_USER_AGENT = "Paradigm Press Catalyst Tracker contact@yourdomain.com"
# Optional: the daily Verdad-style scan as a CSV link (e.g. a Google Sheet published to the web as CSV).
# Locally the app also reads verdad/latest.csv. Neither is in the public repo.
VERDAD_CSV_URL = "https://docs.google.com/spreadsheets/d/e/.../pub?output=csv"
